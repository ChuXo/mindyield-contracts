pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/Ownable2Step.sol";

/**
 * @title PlatformFeeConfig
 * @notice Single owner-controlled registry for every fee lever in the MindYield platform.
 *
 * Why a registry? Each fee site (ContestFactoryV2, NoLossLotteryV2, AutoYieldVault) already
 * has its own setter, but flipping fees on/off platform-wide previously required N transactions.
 * This registry exposes:
 *
 *   1. A single source of truth for the *intended* fee values.
 *   2. A `masterEnabled` global kill switch — when false, every consumer must treat all fees as 0.
 *   3. View helpers (`yieldFeeBps`, `creationFeeUsdc`, etc.) that already apply the kill switch,
 *      so consumers do `cfg.yieldFeeBps()` and never need to remember to check `masterEnabled`.
 *
 * Each consumer contract reads from this registry on initialization (or on demand for vaults that
 * apply fees per-tx). Existing per-contract setters remain functional for granular emergency control.
 *
 * Defaults: storage values start at 0, but the deploy script activates 2% yield-only fees
 * (`contestYieldBps = 200`, `lotteryYieldBps = 200`, `vaultPerformanceBps = 200`) with
 * `masterEnabled = true`. No creation fee or management fee is charged — only generated yield.
 *
 * NOTE: This registry is intentionally minimal. It does not pull fees, hold tokens, or perform
 *       any logic beyond storage + access control. All fee enforcement happens in the consumers.
 */
contract PlatformFeeConfig is Ownable2Step {
    // ─── Constants ─────────────────────────────────────────────────────────────

    uint256 public constant MAX_BPS = 2_000;            // 20%, hard ceiling for any bps fee
    uint256 public constant MAX_VAULT_MGMT_BPS = 200;   // 2%/yr, hard ceiling for management fee
    uint256 public constant BPS_DENOMINATOR = 10_000;

    // ─── State ─────────────────────────────────────────────────────────────────

    /// @notice Master kill switch. When false, every public view returns 0.
    bool public masterEnabled;

    /// @notice Recipient address for protocol fees. **Immutable** — a
    ///         compromised owner cannot redirect future fees by swapping the
    ///         recipient address. To rotate the recipient, deploy a new
    ///         PlatformFeeConfig (and re-bind consumers).
    address public immutable feeRecipient;

    /// @notice Fee on yield generated by ContestV2 contests (bps)
    uint256 internal _contestYieldBps;
    /// @notice Fee on yield generated by NoLossLottery rounds (bps)
    uint256 internal _lotteryYieldBps;
    /// @notice Flat fee in USDC charged on contest creation (6 decimals)
    uint256 internal _contestCreationFeeUsdc;
    /// @notice AutoYieldVault performance fee taken from harvested yield (bps)
    uint256 internal _vaultPerformanceBps;
    /// @notice AutoYieldVault annual management fee on AUM (bps/year)
    uint256 internal _vaultManagementBps;

    // ─── Events ────────────────────────────────────────────────────────────────

    event MasterEnabledUpdated(bool enabled);
    event FeeRecipientSet(address indexed recipient);
    event ContestYieldBpsUpdated(uint256 newBps);
    event LotteryYieldBpsUpdated(uint256 newBps);
    event ContestCreationFeeUsdcUpdated(uint256 newAmount);
    event VaultPerformanceBpsUpdated(uint256 newBps);
    event VaultManagementBpsUpdated(uint256 newBps);

    // ─── Errors ────────────────────────────────────────────────────────────────

    error FeeTooHigh();
    error InvalidRecipient();

    // ─── Constructor ───────────────────────────────────────────────────────────

    /// @dev All values default to zero / disabled. Owner must opt in.
    constructor(address _feeRecipient) Ownable() {
        if (_feeRecipient == address(0)) revert InvalidRecipient();
        feeRecipient = _feeRecipient;
        masterEnabled = false;
        emit FeeRecipientSet(_feeRecipient);
    }

    // ─── Owner: Setters ────────────────────────────────────────────────────────

    function setMasterEnabled(bool enabled) external onlyOwner {
        masterEnabled = enabled;
        emit MasterEnabledUpdated(enabled);
    }

    // setFeeRecipient REMOVED 2026-04-28 — feeRecipient is now constructor-immutable.
    // Rotating the recipient requires deploying a new PlatformFeeConfig and re-binding
    // consumers. This eliminates the soft-rug vector where a compromised owner could
    // redirect future protocol fees via a single onlyOwner tx.

    function setContestYieldBps(uint256 newBps) external onlyOwner {
        if (newBps > MAX_BPS) revert FeeTooHigh();
        _contestYieldBps = newBps;
        emit ContestYieldBpsUpdated(newBps);
    }

    function setLotteryYieldBps(uint256 newBps) external onlyOwner {
        if (newBps > MAX_BPS) revert FeeTooHigh();
        _lotteryYieldBps = newBps;
        emit LotteryYieldBpsUpdated(newBps);
    }

    function setContestCreationFeeUsdc(uint256 newAmount) external onlyOwner {
        _contestCreationFeeUsdc = newAmount;
        emit ContestCreationFeeUsdcUpdated(newAmount);
    }

    function setVaultPerformanceBps(uint256 newBps) external onlyOwner {
        if (newBps > MAX_BPS) revert FeeTooHigh();
        _vaultPerformanceBps = newBps;
        emit VaultPerformanceBpsUpdated(newBps);
    }

    function setVaultManagementBps(uint256 newBps) external onlyOwner {
        if (newBps > MAX_VAULT_MGMT_BPS) revert FeeTooHigh();
        _vaultManagementBps = newBps;
        emit VaultManagementBpsUpdated(newBps);
    }

    // setAll() removed: an atomic batch setter would let an owner change the master switch
    // and the fee recipient in the same tx, defeating the per-setter timelock that the
    // TimelockController owner enforces. Use the individual setters instead — each
    // queues independently through the timelock.

    // ─── Public Views (kill switch applied) ────────────────────────────────────

    /// @notice Effective contest yield fee in bps. Returns 0 when masterEnabled is false.
    function contestYieldBps() external view returns (uint256) {
        return masterEnabled ? _contestYieldBps : 0;
    }

    function lotteryYieldBps() external view returns (uint256) {
        return masterEnabled ? _lotteryYieldBps : 0;
    }

    function contestCreationFeeUsdc() external view returns (uint256) {
        return masterEnabled ? _contestCreationFeeUsdc : 0;
    }

    function vaultPerformanceBps() external view returns (uint256) {
        return masterEnabled ? _vaultPerformanceBps : 0;
    }

    function vaultManagementBps() external view returns (uint256) {
        return masterEnabled ? _vaultManagementBps : 0;
    }

    /// @notice Returns every fee in a single call (gas-efficient for off-chain readers).
    function getAll() external view returns (
        bool _masterEnabled,
        address _feeRecipient,
        uint256 _yieldBps,
        uint256 _lotteryBps,
        uint256 _creationFeeUsdc,
        uint256 _vaultPerfBps,
        uint256 _vaultMgmtBps
    ) {
        _masterEnabled = masterEnabled;
        _feeRecipient = feeRecipient;
        if (masterEnabled) {
            _yieldBps = _contestYieldBps;
            _lotteryBps = _lotteryYieldBps;
            _creationFeeUsdc = _contestCreationFeeUsdc;
            _vaultPerfBps = _vaultPerformanceBps;
            _vaultMgmtBps = _vaultManagementBps;
        }
    }

    /// @notice Raw stored values, ignoring kill switch. For admin tooling only.
    function getRaw() external view returns (
        uint256 _yieldBps,
        uint256 _lotteryBps,
        uint256 _creationFeeUsdc,
        uint256 _vaultPerfBps,
        uint256 _vaultMgmtBps
    ) {
        _yieldBps = _contestYieldBps;
        _lotteryBps = _lotteryYieldBps;
        _creationFeeUsdc = _contestCreationFeeUsdc;
        _vaultPerfBps = _vaultPerformanceBps;
        _vaultMgmtBps = _vaultManagementBps;
    }
}
